---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/common/Header.astro';
import Hero from '../components/sections/Hero.astro';
import CredentialsStrip from '../components/sections/CredentialsStrip.astro';
import AudienceSection from '../components/sections/AudienceSection.astro';
import BenefitsGrid from '../components/sections/BenefitsGrid.astro';
import AboutSection from '../components/sections/AboutSection.astro';
import MethodSection from '../components/sections/MethodSection.astro';
import ConsultationSteps from '../components/sections/ConsultationSteps.astro';
import PlansSection from '../components/sections/PlansSection.astro';
import TestimonialsCarousel from '../components/sections/TestimonialsCarousel.astro';
import FaqSection from '../components/sections/FaqSection.astro';
import FinalCta from '../components/sections/FinalCta.astro';
import FloatingWhatsApp from '../components/ui/FloatingWhatsApp.astro';
import Footer from '../components/common/Footer.astro';
---

<BaseLayout>
  <Header />
	<main id="conteudo-principal">
		<Hero />
    <CredentialsStrip />
    <AudienceSection />
    <BenefitsGrid />
    <AboutSection />
    <MethodSection />
    <ConsultationSteps />
    <PlansSection />
    <TestimonialsCarousel />
    <FaqSection />
    <FinalCta />
	</main>
  <Footer />
  <FloatingWhatsApp />
</BaseLayout>
