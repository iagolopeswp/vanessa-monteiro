---
import { siteConfig } from '../config/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const { 
  title = `${siteConfig.name} | Nutricionista Clínica Funcional`, 
  description = "Acompanhamento nutricional online e personalizado para mulheres 35+, com foco em saúde, energia, composição corporal e longevidade.", 
  ogImage = "/og-image.jpg"
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site || siteConfig.siteUrl);
---

<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalUrl} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site || siteConfig.siteUrl)} />
    <meta property="og:locale" content="pt_BR" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(ogImage, Astro.site || siteConfig.siteUrl)} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🌿</text></svg>" />

    <link rel="preload" as="image" href="/banner-vanessa-monteiro.webp" fetchpriority="high">


    <!-- JSON-LD SEO Structured Data -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Vanessa Monteiro",
        "jobTitle": "Nutricionista Clínica Funcional",
        "url": "https://vanessamonteironutri.com.br",
        "sameAs": [
          "https://www.instagram.com/vanessamonteironutri/"
        ],
        "description": "Acompanhamento nutricional online e personalizado para mulheres 35+, com foco em saúde, energia, composição corporal e longevidade.",
        "image": "https://vanessamonteironutri.com.br/og-image.jpg"
      }
    </script>
  </head>
  <body>
    <a href="#conteudo-principal" class="skip-link">Pular para o conteúdo principal</a>
    
    <slot />

    <script>
      import { initAnimations } from '../scripts/animations';
      
      let animationsInitialized = false;

      function startAnimations() {
        if (animationsInitialized) return;
        animationsInitialized = true;
        
        // Remove event listeners
        window.removeEventListener('scroll', startAnimations);
        window.removeEventListener('mousemove', startAnimations);
        window.removeEventListener('touchstart', startAnimations);

        requestAnimationFrame(() => {
          initAnimations();
        });
      }

      // Initialize on first user interaction to bypass PageSpeed LCP block
      window.addEventListener('scroll', startAnimations, { passive: true, once: true });
      window.addEventListener('mousemove', startAnimations, { passive: true, once: true });
      window.addEventListener('touchstart', startAnimations, { passive: true, once: true });
      
      // Fallback: initialize after 2 seconds if no interaction
      setTimeout(startAnimations, 2000);
    </script>
  </body>
</html>
