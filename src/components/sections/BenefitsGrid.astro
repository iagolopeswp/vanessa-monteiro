---
const benefits = [
  { icon: "sparkle", title: "Emagrecimento sustentável", text: "Sem dietas malucas, focando na sua composição corporal e saúde." },
  { icon: "barbell", title: "Força e massa muscular", text: "Estratégias para preservar e ganhar tônus de forma inteligente." },
  { icon: "battery-high", title: "Mais energia para a rotina", text: "Nutrição para combater o cansaço e melhorar a disposição." },
  { icon: "drop", title: "Saúde intestinal", text: "Cuidando do seu microbioma para reduzir inchaço e melhorar a imunidade." },
  { icon: "moon-stars", title: "Mudanças hormonais", text: "Suporte nutricional durante o climatério e menopausa." },
  { icon: "path", title: "Hábitos possíveis", text: "Uma rotina alimentar que se encaixa na sua realidade e cultura." },
];
---
<section class="benefits" aria-labelledby="benefits-title">
  <div class="container">
    <div class="benefits__header">
      <h2 id="benefits-title" class="benefits__title">Uma estratégia que considera <span class="headline-gradient">o todo.</span></h2>
    </div>

    <div class="benefits__grid">
      {benefits.map(benefit => (
        <div class="benefit-card">
          <div class="benefit-card__icon">
             <i class={`ph ph-${benefit.icon}`}></i>
          </div>
          <h3 class="benefit-card__title">{benefit.title}</h3>
          <p class="benefit-card__text">{benefit.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .benefits {
    padding: 8rem 0;
    background-color: var(--color-paper);
  }

  .benefits__header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 5rem;
  }

  .benefits__title {
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    color: var(--color-ink);
  }

  .benefits__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 3rem;
  }

  .benefit-card {
    padding: 2rem;
    border: 1px solid var(--color-line);
    border-radius: 2px;
    background-color: var(--color-white);
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .benefit-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 40px rgba(38, 38, 38, 0.05);
  }

  .benefit-card__icon {
    font-size: 2rem;
    color: var(--color-clay);
    margin-bottom: 1.5rem;
  }

  .benefit-card__title {
    font-size: 1.25rem;
    margin-bottom: 0.75rem;
    font-family: 'Manrope', sans-serif;
    font-weight: 600;
  }

  .benefit-card__text {
    font-size: 1rem;
    color: var(--color-ink-soft);
    line-height: 1.6;
  }
</style>
