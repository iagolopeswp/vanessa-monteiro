---
import Button from '../ui/Button.astro';
import { siteConfig } from '../../config/site';

// TODO_ASSET: Imagem final da Vanessa
const heroBg = "/banner-vanessa-monteiro.webp"; 
---
<section class="hero" aria-labelledby="hero-title" style={`background-image: url('${heroBg}');`}>
  <div class="container hero__container">
    <div class="hero__content">
      <span class="hero__eyebrow">Nutrição Clínica Funcional e Integrativa</span>
      
      <h1 id="hero-title" class="hero__title">
        Ciência, acolhimento e <span class="headline-gradient">estratégia</span> para a mulher 30+ viver sua melhor versão.
      </h1>
      
      <p class="hero__subtitle">
        Emagrecimento, energia, equilíbrio hormonal e longevidade. Um acompanhamento nutricional totalmente personalizado para a sua rotina no Brasil ou no exterior.
      </p>
      
      <div class="hero__actions">
        <Button href={siteConfig.bookingUrl} variant="primary" data-analytics="cta_booking_click" data-location="hero">
          Quero meu plano personalizado
        </Button>
      </div>
    </div>
    <div class="hero__visual">
      <!-- Coluna mantida sem a imagem -->
    </div>
  </div>
  
  <div class="hero__vertical-text">
    <span>Nutrição personalizada para brasileiras no Reino Unido e além</span>
  </div>
</section>

<style>
  .hero {
    padding: 0;
    height: 732px;
    display: flex;
    align-items: center;
    background-color: var(--color-paper);
    background-image: var(--hero-bg); /* O React/Astro injetou no style, vou manter por lá, mas forçar a tag: */
    background-size: cover;
    background-position: top center;
    background-repeat: no-repeat;
    position: relative;
    overflow: visible;
  }


  .hero__container {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 4rem;
    align-items: center;
  }

  @media (max-width: 1024px) {
    .hero__container {
      grid-template-columns: 1fr;
      gap: 3rem;
      padding-top: 4rem;
    }
  }

  .hero__content {
    max-width: 600px;
  }

  .hero__eyebrow {
    display: block;
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-taupe);
    margin-bottom: 1.5rem;
  }

  .hero__title {
    font-size: clamp(2rem, 4vw, 3.5rem);
    line-height: 1em;
    margin-bottom: 1.5rem;
    color: var(--color-ink);
  }

  .hero__subtitle {
    font-size: clamp(0.875rem, 1.5vw, 1.125rem);
    color: var(--color-ink-soft);
    margin-bottom: 3rem;
    max-width: 500px;
  }

  .hero__actions {
    display: flex;
    gap: 1rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }

  .hero__vertical-text {
    position: absolute;
    right: 2rem;
    top: 50%;
    transform: translateY(-50%) rotate(-180deg);
    writing-mode: vertical-rl;
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--color-ink);
    opacity: 0.7;
    border-left: 1px solid var(--color-ink);
    padding-left: 1rem;
    height: 300px;
    display: flex;
    justify-content: center;
  }

  @media (max-width: 1024px) {
    .hero__vertical-text {
      display: none; /* Ocultar no mobile para não poluir */
    }
  }

  .hero__visual {
    position: relative;
    height: 100%;
    min-height: 500px;
  }

  .hero__image-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 2px;
    overflow: hidden;
  }

  .hero__image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: 3/4;
  }

  .hero__badge {
    position: absolute;
    bottom: 2rem;
    left: -2rem;
    background-color: var(--color-paper);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    box-shadow: 0 10px 30px rgba(38, 38, 38, 0.05);
  }

  .hero__badge span {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 600;
  }

  .hero__badge span:first-child {
    color: var(--color-clay);
  }

  @media (max-width: 1024px) {
    .hero__visual {
      min-height: 400px;
      order: -1;
    }
    
    .hero__badge {
      left: 1rem;
      bottom: 1rem;
      padding: 1rem;
    }
  }
</style>
