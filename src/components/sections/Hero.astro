---
import Button from '../ui/Button.astro';
import { siteConfig } from '../../config/site';

// TODO_ASSET: Imagem final da Vanessa
const heroImage = "https://images.unsplash.com/photo-1559839734-2b71ea197ec2?auto=format&fit=crop&w=800&q=80"; 
---
<section class="hero" aria-labelledby="hero-title">
  <div class="container hero__container">
    <div class="hero__content">
      <span class="hero__eyebrow">Nutrição clínica funcional para mulheres 35+</span>
      
      <h1 id="hero-title" class="hero__title">
        Ciência, acolhimento e <span class="headline-gradient">estratégia</span> para você se sentir bem no próprio corpo.
      </h1>
      
      <p class="hero__subtitle">
        Acompanhamento nutricional online para brasileiras no Reino Unido e em outros países, com uma abordagem personalizada, prática e baseada em evidências.
      </p>
      
      <div class="hero__actions">
        <Button href={siteConfig.bookingUrl} variant="primary" data-analytics="cta_booking_click" data-location="hero">
          Agendar consulta
        </Button>
        <Button href="#metodo" variant="outline" data-analytics="hero_method_click" data-location="hero">
          Conhecer o acompanhamento
        </Button>
      </div>
      
      <div class="hero__trust">
        <p>Atendimento online &bull; Estratégia individualizada &bull; Brasil e exterior</p>
      </div>
    </div>
    
    <div class="hero__visual">
      <div class="hero__image-wrapper">
        <img src={heroImage} alt="Fotografia de perfil de Vanessa Monteiro" fetchpriority="high" decoding="async" />
        <div class="hero__badge">
          <span>Reino Unido</span>
          <span>Atendimento online</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 10rem 0 6rem;
    min-height: 100vh;
    display: flex;
    align-items: center;
    background-color: var(--color-paper);
    position: relative;
    overflow: hidden;
  }

  .hero__container {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 4rem;
    align-items: center;
  }

  @media (max-width: 1024px) {
    .hero__container {
      grid-template-columns: 1fr;
      gap: 3rem;
      padding-top: 4rem;
    }
  }

  .hero__content {
    max-width: 600px;
  }

  .hero__eyebrow {
    display: block;
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-taupe);
    margin-bottom: 1.5rem;
  }

  .hero__title {
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    margin-bottom: 1.5rem;
    color: var(--color-ink);
  }

  .hero__subtitle {
    font-size: clamp(1rem, 2vw, 1.125rem);
    color: var(--color-ink-soft);
    margin-bottom: 3rem;
    max-width: 500px;
  }

  .hero__actions {
    display: flex;
    gap: 1rem;
    margin-bottom: 4rem;
    flex-wrap: wrap;
  }

  .hero__trust {
    font-size: 0.875rem;
    color: var(--color-ink-soft);
    opacity: 0.8;
  }

  .hero__visual {
    position: relative;
    height: 100%;
    min-height: 500px;
  }

  .hero__image-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 2px;
    overflow: hidden;
  }

  .hero__image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: 3/4;
  }

  .hero__badge {
    position: absolute;
    bottom: 2rem;
    left: -2rem;
    background-color: var(--color-paper);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    box-shadow: 0 10px 30px rgba(38, 38, 38, 0.05);
  }

  .hero__badge span {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 600;
  }

  .hero__badge span:first-child {
    color: var(--color-clay);
  }

  @media (max-width: 1024px) {
    .hero__visual {
      min-height: 400px;
      order: -1;
    }
    
    .hero__badge {
      left: 1rem;
      bottom: 1rem;
      padding: 1rem;
    }
  }
</style>
