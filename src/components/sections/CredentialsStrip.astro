---
---
<section class="credentials" aria-label="Credenciais">
  <div class="container">
    <ul class="credentials__list">
      <li>Nutricionista formada pela UFOP</li>
      <li>Natural Chef</li>
      <li>Especialista em Reprogramação Epigenética Eficiente</li>
      <li>Atendimento online internacional</li>
    </ul>
  </div>
</section>

<style>
  .credentials {
    background-color: var(--color-ink);
    color: var(--color-paper);
    padding: 3rem 0;
    border-top: 1px solid var(--color-line-dark);
    border-bottom: 1px solid var(--color-line-dark);
  }

  .credentials__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2rem 4rem;
    text-align: center;
  }

  .credentials__list li {
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-sand);
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  @media (min-width: 768px) {
    .credentials__list li:not(:last-child)::after {
      content: '';
      display: block;
      width: 4px;
      height: 4px;
      border-radius: 50%;
      background-color: var(--color-clay);
      margin-left: 3rem;
    }
  }
</style>
