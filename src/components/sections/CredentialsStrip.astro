---
const credentials = [
  "Atendimento Online Internacional",
  "Nutrição Baseada em Evidências",
  "Alimentação Adaptada à Sua Rotina",
  "Acompanhamento Personalizado"
];
const marqueeItems = [...credentials, ...credentials, ...credentials, ...credentials];
---
<section class="marquee" aria-label="Credenciais" role="marquee">
  <div class="marquee__inner">
    {marqueeItems.map((item) => (
      <div class="marquee__pill">
        <span>{item}</span>
      </div>
    ))}
  </div>
</section>

<style>
  .marquee {
    background-color: rgba(38, 38, 38, 0.45);
    -webkit-backdrop-filter: blur(12px);
    padding: 1.5rem 0;
    overflow: hidden;
    white-space: nowrap;
    border-top: 1px solid rgba(255,255,255,0.1);
    border-bottom: none;
    position: relative;
    z-index: 10;
    margin-top: -43px;
    margin-bottom: -43px;
    display: flex;
  }

  @supports (backdrop-filter: blur(12px)) {
    .marquee {
      backdrop-filter: blur(12px);
    }
  }

  .marquee__inner {
    display: flex;
    gap: 2rem;
    padding-right: 2rem;
    animation: scrollText 30s linear infinite;
    will-change: transform;
  }

  .marquee__inner:hover {
    animation-play-state: paused;
  }

  .marquee__pill {
    background-color: transparent;
    border: 1px solid var(--color-clay);
    border-radius: 50px;
    padding: 0.5rem 1.5rem;
    color: #ffffff;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
  }

  @keyframes scrollText {
    0% { transform: translateX(0); }
    100% { transform: translateX(calc(-25%)); }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee__inner {
      animation-play-state: paused !important;
      animation-duration: 0.01ms !important;
    }
  }
</style>
