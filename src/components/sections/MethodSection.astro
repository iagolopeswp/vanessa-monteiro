---
const steps = [
  { title: "Escuta e investigação", text: "Compreensão da história, rotina, sintomas, preferências, objetivos e contexto." },
  { title: "Análise individualizada", text: "Avaliação nutricional e análise de exames ou biomarcadores quando pertinentes e disponibilizados pela paciente." },
  { title: "Estratégia prática", text: "Plano alimentar e orientações adaptados à realidade, cultura, disponibilidade e fase de vida." },
  { title: "Acompanhamento contínuo", text: "Ajustes ao longo do processo para apoiar consistência, aprendizado e evolução." }
];
---
<section id="metodo" class="method section section--dark" aria-labelledby="method-title">
  <div class="container method__container">
    <div class="method__header">
      <h2 id="method-title" class="method__title">Um plano construído para a sua <span class="headline-gradient">vida real.</span></h2>
      <p class="method__support">Não é sobre perfeição. É sobre constância com propósito e evolução possível.</p>
    </div>

    <div class="method__steps">
      {steps.map((step, index) => (
        <div class="method-step">
          <span class="method-step__number">{(index + 1).toString().padStart(2, '0')}</span>
          <div class="method-step__content">
            <h3 class="method-step__title">{step.title}</h3>
            <p class="method-step__text">{step.text}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .method {
    background-color: var(--color-ink);
    color: var(--color-paper);
    padding: 8rem 0;
  }

  .method__container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6rem;
  }

  @media (max-width: 900px) {
    .method__container {
      grid-template-columns: 1fr;
      gap: 4rem;
    }
  }

  .method__header {
    position: sticky;
    top: 8rem;
    align-self: start;
    max-width: 500px;
  }

  .method__title {
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    margin-bottom: 2rem;
    line-height: 1.1;
  }

  .method__support {
    font-size: 1.25rem;
    color: var(--color-sand);
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
  }

  .method__steps {
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }

  .method-step {
    display: flex;
    gap: 2rem;
  }

  @media (max-width: 600px) {
    .method-step {
      flex-direction: column;
      gap: 1rem;
    }
  }

  .method-step__number {
    font-size: 1.5rem;
    font-family: 'Cormorant Garamond', serif;
    color: var(--color-clay);
    font-weight: 600;
  }

  .method-step__title {
    font-size: 1.5rem;
    margin-bottom: 1rem;
    font-weight: 500;
  }

  .method-step__text {
    font-size: 1.125rem;
    color: var(--color-sand);
    opacity: 0.9;
    line-height: 1.6;
  }
</style>
