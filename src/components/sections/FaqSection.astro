---
const faqs = [
  { question: "Como funciona o atendimento online?", answer: "A consulta é realizada via chamada de vídeo e tem duração média de 1 hora. Nela, conversamos detalhadamente sobre seus objetivos, histórico de saúde e rotina." },
  { question: "O plano alimentar é difícil de seguir?", answer: "Não. O planejamento é 100% individualizado, considerando sua realidade, cultura e os ingredientes disponíveis onde você mora. O objetivo é que seja prático e sustentável." },
  { question: "Você prescreve suplementos e analisa exames?", answer: "Sim. A avaliação de exames laboratoriais faz parte da conduta, e a suplementação é indicada de forma pontual e estratégica, apenas quando há real necessidade." },
  { question: "Em quanto tempo recebo o plano?", answer: "O material completo (plano alimentar, orientações, lista de compras e materiais de apoio) é entregue no aplicativo do paciente em até 3 dias úteis após a consulta." }
];
---
<section id="faq" class="faq section" aria-labelledby="faq-title">
  <div class="container faq__container">
    <div class="faq__left">
      <div class="faq__header">
        <span class="section-tag">Dúvidas</span>
        <h2 id="faq-title" class="faq__title">Perguntas <span class="headline-gradient">frequentes</span></h2>
      </div>
      <div class="faq__questions" role="tablist" aria-label="Perguntas Frequentes">
        {faqs.map((faq, index) => (
          <button 
            id={`faq-tab-${index}`}
            class={`faq-tab ${index === 0 ? 'is-active' : ''}`} 
            role="tab" 
            aria-selected={index === 0 ? 'true' : 'false'}
            aria-controls={`faq-panel-${index}`}
            tabindex={index === 0 ? '0' : '-1'}
            data-index={index}
          >
            {faq.question}
          </button>
        ))}
      </div>
    </div>
    
    <div class="faq__right">
      {faqs.map((faq, index) => (
        <div 
          id={`faq-panel-${index}`}
          class={`faq-panel ${index === 0 ? 'is-active' : ''}`} 
          role="tabpanel"
          aria-labelledby={`faq-tab-${index}`}
          tabindex="0"
          data-index={index}
        >
          <p>{faq.answer}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .faq {
    padding: 8rem 0;
    background-color: var(--color-paper);
  }

  .faq__container {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 4rem;
    align-items: start;
  }

  @media (max-width: 768px) {
    .faq__container {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  .faq__left {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .faq__header {
    text-align: left;
    margin-bottom: 0;
  }

  .section-tag {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 1rem;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-weight: 600;
    color: var(--color-clay-text);
    margin-bottom: 1.5rem;
  }
  .section-tag::after {
    content: '';
    display: block;
    width: 40px;
    height: 1px;
    background-color: var(--color-clay);
  }

  .faq__title {
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    color: var(--color-ink);
  }

  .faq__questions {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    border-left: 2px solid var(--color-line);
    padding-left: 2rem;
    margin-top: 2rem;
  }

  .faq-tab {
    text-align: left;
    background: transparent;
    border: none;
    font-size: 1.25rem;
    font-family: 'Cormorant Garamond', serif;
    font-weight: 600;
    color: var(--color-ink-soft);
    cursor: pointer;
    padding: 0;
    transition: color 0.3s ease, transform 0.3s ease;
    position: relative;
    line-height: 1.4;
  }

  .faq-tab::before {
    content: '';
    position: absolute;
    left: -2rem;
    top: 50%;
    transform: translateY(-50%);
    width: 2px;
    height: 0;
    background-color: var(--color-clay);
    transition: height 0.3s ease;
  }

  .faq-tab:hover {
    color: var(--color-ink);
  }

  .faq-tab.is-active {
    color: var(--color-clay-text);
    transform: translateX(10px);
  }

  .faq-tab.is-active::before {
    height: 100%;
  }

  .faq__right {
    position: relative;
    background: linear-gradient(135deg, var(--color-paper) 0%, #fdfbf7 100%);
    padding: 4rem;
    border: 1px solid var(--color-line);
    min-height: 350px;
    border-radius: 12px;
    box-shadow: 0 10px 40px rgba(0,0,0,0.03);
    overflow: hidden;
  }

  .faq__right::before {
    content: '?';
    position: absolute;
    bottom: -3rem;
    right: 2rem;
    font-size: 15rem;
    font-family: 'Cormorant Garamond', serif;
    color: var(--color-clay);
    opacity: 0.05;
    line-height: 1;
    font-style: italic;
    pointer-events: none;
  }

  .faq-panel {
    position: absolute;
    top: 4rem;
    left: 4rem;
    right: 4rem;
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition: all 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .faq-panel.is-active {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .faq-panel p {
    font-size: 1.25rem;
    font-family: 'Cormorant Garamond', serif;
    line-height: 1.8;
    color: var(--color-ink);
  }

  @media (max-width: 768px) {
    .faq__right {
      min-height: 300px;
      padding: 2rem;
    }
    .faq-panel {
      top: 2rem; left: 2rem; right: 2rem;
    }
    .faq__questions {
      padding-left: 1.5rem;
      border-left: 1px solid var(--color-line);
    }
    .faq-tab::before {
      left: -1.5rem;
      width: 1px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tabs = document.querySelectorAll('.faq-tab');
    const panels = document.querySelectorAll('.faq-panel');

    tabs.forEach((tab, index) => {
      // Click event
      tab.addEventListener('click', () => {
        activateTab(index);
      });

      // Keyboard navigation (ARIA Tabs pattern)
      tab.addEventListener('keydown', (e) => {
        const keyboardEvent = e as KeyboardEvent;
        let targetIndex = -1;

        if (keyboardEvent.key === 'ArrowDown' || keyboardEvent.key === 'ArrowRight') {
          targetIndex = (index + 1) % tabs.length;
          keyboardEvent.preventDefault();
        } else if (keyboardEvent.key === 'ArrowUp' || keyboardEvent.key === 'ArrowLeft') {
          targetIndex = (index - 1 + tabs.length) % tabs.length;
          keyboardEvent.preventDefault();
        } else if (keyboardEvent.key === 'Home') {
          targetIndex = 0;
          keyboardEvent.preventDefault();
        } else if (keyboardEvent.key === 'End') {
          targetIndex = tabs.length - 1;
          keyboardEvent.preventDefault();
        }

        if (targetIndex !== -1) {
          activateTab(targetIndex);
          (tabs[targetIndex] as HTMLElement).focus();
        }
      });
    });

    function activateTab(index: number) {
      tabs.forEach((t, i) => {
        const isSelected = i === index;
        t.classList.toggle('is-active', isSelected);
        t.setAttribute('aria-selected', isSelected ? 'true' : 'false');
        t.setAttribute('tabindex', isSelected ? '0' : '-1');
      });

      panels.forEach((p, i) => {
        const isSelected = i === index;
        p.classList.toggle('is-active', isSelected);
      });
    }
  });
</script>
