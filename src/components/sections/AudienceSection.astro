---
import Icon from '../ui/Icon.astro';
---
<section id="para-quem-e" class="audience section section--dark" aria-labelledby="audience-title">
  <div class="container audience__layout">
    
    <div class="audience__header">
      <span class="section-tag">Para Quem É</span>
      <h2 id="audience-title" class="audience__title">
        Você não precisa de mais uma dieta <span class="headline-gradient">impossível</span> de seguir.
      </h2>
      <p class="audience__text">
        O acompanhamento foi pensado para mulheres que querem cuidar da saúde sem ignorar a própria rotina, cultura, fase de vida e objetivos. A estratégia nasce do seu contexto — não de uma fórmula pronta.
      </p>
    </div>

    <div class="bento-grid">
      <div class="bento-card glow-card">
        <Icon name="check-circle" size={24} class="icon-clay" />
        <span>Sente dificuldade em manter constância</span>
      </div>
      <div class="bento-card glow-card">
        <Icon name="check-circle" size={24} class="icon-clay" />
        <span>Deseja emagrecer preservando massa muscular</span>
      </div>
      <div class="bento-card glow-card">
        <Icon name="check-circle" size={24} class="icon-clay" />
        <span>Percebe queda de energia e disposição</span>
      </div>
      <div class="bento-card glow-card">
        <Icon name="check-circle" size={24} class="icon-clay" />
        <span>Mudanças do climatério ou menopausa</span>
      </div>
      <div class="bento-card glow-card">
        <Icon name="check-circle" size={24} class="icon-clay" />
        <span>Melhorar a relação com a alimentação</span>
      </div>
      <div class="bento-card glow-card">
        <Icon name="check-circle" size={24} class="icon-clay" />
        <span>Orientação profissional sem extremismos</span>
      </div>
    </div>

  </div>
</section>

<style>
  .section--dark {
    background-color: var(--color-ink);
    color: var(--color-paper);
    padding: 8rem 0;
  }

  .audience__layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }

  @media (max-width: 1024px) {
    .audience__layout {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }

  .section-tag {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-weight: 600;
    color: var(--color-sand);
    margin-bottom: 1.5rem;
  }
  .section-tag::after {
    content: '';
    display: block;
    width: 60px;
    height: 1px;
    background-color: var(--color-sand);
    opacity: 0.5;
  }

  .audience__title {
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    margin-bottom: 1.5rem;
    line-height: 1.2;
  }

  .audience__title .headline-gradient {
    font-size: inherit;
    font-style: italic;
    font-weight: 400;
  }

  .audience__text {
    font-size: 1.125rem;
    color: var(--color-paper);
    opacity: 0.8;
  }

  .bento-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-auto-rows: minmax(140px, auto);
    gap: 1rem;
  }

  @media (max-width: 600px) {
    .bento-grid {
      grid-template-columns: 1fr;
    }
  }

  .bento-card {
    background-color: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--color-line-dark);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    border-radius: 0;
    transition: background-color 0.3s ease;
    position: relative;
    overflow: hidden;
  }

  /* Glow Effect */
  .glow-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(
      400px circle at var(--mouse-x, 0) var(--mouse-y, 0),
      rgba(230, 168, 23, 0.15),
      transparent 40%
    );
    opacity: 0;
    transition: opacity 0.3s;
    pointer-events: none;
    z-index: 0;
  }

  .glow-card:hover::before {
    opacity: 1;
  }

  .glow-card > * {
    position: relative;
    z-index: 1;
  }

  .bento-card span {
    font-size: 1rem;
    color: var(--color-paper);
    line-height: 1.4;
  }

  .icon-clay {
    color: var(--color-clay);
    font-size: 1.75rem;
    margin-bottom: 1rem;
  }
</style>

<script is:inline>
  function initGlowCards() {
    const cards = document.querySelectorAll('.glow-card');
    cards.forEach(card => {
      card.addEventListener('mousemove', e => {
        const rect = card.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        card.style.setProperty('--mouse-x', `${x}px`);
        card.style.setProperty('--mouse-y', `${y}px`);
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initGlowCards);
  document.addEventListener('astro:page-load', initGlowCards);
</script>
